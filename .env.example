# ============================================
# App Correspondência - Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env.local e preencha com suas credenciais.
# NUNCA commite o arquivo .env.local no repositório.

# --------------------------------------------
# Supabase (Auth + Postgres + Storage)
# --------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://supabase.seudominio.com.br
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...
SUPABASE_JWT_SECRET=...

# --------------------------------------------
# Resend (envio de e-mails)
# Painel: https://resend.com/api-keys
# --------------------------------------------
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="App Correspondencia <nao-responda@seudominio.com.br>"
EMAIL_REPLY_TO=suporte@seudominio.com.br
SMTP_ADMIN_EMAIL=admin@seudominio.com.br

# --------------------------------------------
# Application
# --------------------------------------------
NEXT_PUBLIC_BASE_URL=https://seudominio.com.br
NEXT_PUBLIC_APP_URL=https://seudominio.com.br
