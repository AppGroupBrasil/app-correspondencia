# ============================================
# CORRESPONDÊNCIA MANUS - Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env.local e preencha com suas credenciais
# NUNCA commite o arquivo .env.local no repositório!

# --------------------------------------------
# Firebase Configuration
# Obtenha essas credenciais em: https://console.firebase.google.com/
# --------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=sua_api_key_aqui
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=seu_projeto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=seu_projeto_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=seu_projeto.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=seu_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=seu_app_id

# --------------------------------------------
# Firebase Admin (obrigatório para APIs server-side protegidas)
# Gere uma service account no Firebase Console > Configurações do Projeto > Contas de serviço
# FIREBASE_PRIVATE_KEY deve manter os \n escapados quando usado em .env
# --------------------------------------------
FIREBASE_PROJECT_ID=seu_projeto_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu_projeto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_AQUI\n-----END PRIVATE KEY-----\n"

# --------------------------------------------
# Gmail SMTP Configuration (Senha de App do Google)
# Gere em: https://myaccount.google.com/apppasswords
# ⚠️ IMPORTANTE: Estas chaves NUNCA devem começar com NEXT_PUBLIC_
# --------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM="App Correspondência <seuemail@gmail.com>"
EMAIL_REPLY_TO=suporte@seudominio.com.br

# Email que receberá notificações de novos cadastros
SMTP_ADMIN_EMAIL=seuemail@gmail.com

# --------------------------------------------
# Application Configuration
# --------------------------------------------
NEXT_PUBLIC_BASE_URL=https://seudominio.com.br
NEXT_PUBLIC_APP_URL=https://seudominio.com.br

# --------------------------------------------
# Demo Mode (opcional - para testes sem Firebase)
# --------------------------------------------
# NEXT_PUBLIC_DEMO=false
